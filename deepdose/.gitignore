# env files (can opt-in for committing if needed)
.env*

# GCP Search Console service account key (local test only)
gsc-service-account.json
gsc-*.json

# vercel
.vercel

# Source masters / scratch (compressed web copies live in public/)
_local_media/
.preview/
.tmp-grid-thumbs/
preview-screenshots/

# typescript
*.tsbuildinfo
next-env.d.ts
