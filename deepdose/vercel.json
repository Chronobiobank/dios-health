{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "regions": ["lhr1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "deepdose.org" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "unmed.net" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.unmed.net" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "dios.health" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.dios.health" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "secopeutic.com" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.secopeutic.com" }],
      "destination": "https://www.deepdose.org/:path*",
      "permanent": true
    }
  ]
}
